{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: g++ build sim",
      "command": "g++",
      "args": [
        "-std=c++23",
        "-Wall",
        "-Wextra",
        "-g",
        "-O0",
        "-Iinclude",
        "src/simulation/main.cpp",
        "src/simulation/simulation.cpp",
        "src/simulation/config_loader.cpp",
        "-o",
        "${workspaceFolder}/bin/sim.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
